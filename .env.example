# =============================================================================
# ic-research-lab — Configuração de Ambiente (.env.example)
# =============================================================================
# Copie este arquivo para `.env` na raiz do repositório:
#   cp .env.example .env
#
# REGRA DE OURO:
# Nenhum dado científico real (PDBs, bibliotecas de peptídeos reais, gravações
# de IMU de pacientes, checkpoints) deve entrar no controle de versão.
# Para desenvolvimento local e testes automatizados, os scripts de cada módulo
# geram dados sintéticos em diretórios ignorados pelo Git (`data/synthetic/`).
# =============================================================================

# -----------------------------------------------------------------------------
# Infraestrutura Compartilhada (ic_core)
# -----------------------------------------------------------------------------
# Ambiente de execução: development | test | production
IC_ENV=development

# Nível de log estruturado: DEBUG | INFO | WARNING | ERROR
IC_LOG_LEVEL=INFO

# Formato de saída dos logs: console | json
IC_LOG_FORMAT=console

# Semente global padrão para reprodutibilidade científica
IC_RANDOM_SEED=42

# Diretório raiz base para dados (sintéticos no dev; caminho externo em prod)
IC_DATA_ROOT=./data

# Diretório de cache em disco para evitar recomputação e submissões repetidas
IC_CACHE_DIR=./.cache

# -----------------------------------------------------------------------------
# Módulo A — peptide-docking (Triagem de peptídeos contra alvo de Leishmania)
# -----------------------------------------------------------------------------
# Caminho para o arquivo tabular (Parquet/CSV) com a biblioteca de 634 peptídeos
PEPTIDE_LIBRARY_PATH=./data/synthetic/peptide_docking/peptides_634.parquet

# Caminho para o arquivo de metadados/estrutura da proteína-alvo de Leishmania
PEPTIDE_TARGET_PATH=./data/synthetic/peptide_docking/leishmania_target.json

# Diretório onde runs e resultados de docking são persistidos
PEPTIDE_RUNS_DIR=./data/synthetic/peptide_docking/runs

# Engine padrão de docking: mock | hpepdock
PEPTIDE_DOCKING_ENGINE=mock

# Configurações do adaptador HPEPDOCK
# ATENÇÃO: Respeite os termos de uso do servidor HPEPDOCK. Sem credencial ou
# autorização explícita para submissão automatizada, o adaptador opera em modo
# stub seguro e recomenda engines locais open-source.
HPEPDOCK_BASE_URL=http://huanglab.phys.hust.edu.cn/hpepdock/
HPEPDOCK_API_TOKEN=
HPEPDOCK_ALLOW_AUTOMATED_SUBMISSION=false
HPEPDOCK_MIN_INTERVAL_SECONDS=30.0
HPEPDOCK_MAX_RETRIES=3
HPEPDOCK_BATCH_SIZE=10

# Porta da API FastAPI e URL consumida pelo Front A
PEPTIDE_API_HOST=127.0.0.1
PEPTIDE_API_PORT=8001
NEXT_PUBLIC_PEPTIDE_API_URL=http://127.0.0.1:8001

# -----------------------------------------------------------------------------
# Módulo B — fog-gnn (Predição de Freezing of Gait em Parkinson com GNN)
# -----------------------------------------------------------------------------
# PRIVACIDADE: Dados reais de pacientes são sensíveis e devem residir fora do
# repositório, usando apenas identificadores anonimizados (ex.: SUBJ_001).
FOG_DATASET_DIR=./data/synthetic/fog_gnn/imu_dataset

# Diretório onde experimentos, métricas LOSO e grafos são persistidos
FOG_EXPERIMENTS_DIR=./data/synthetic/fog_gnn/experiments

# Parâmetros padrão de janelamento e amostragem do sinal IMU
FOG_SAMPLING_RATE_HZ=100
FOG_WINDOW_SIZE_SECONDS=2.56
FOG_WINDOW_STRIDE_SECONDS=1.28

# Limiar de correlação de Pearson para arestas funcionais dinâmicas no grafo
FOG_CORRELATION_THRESHOLD=0.60

# Porta da API FastAPI e URL consumida pelo Front B
FOG_API_HOST=127.0.0.1
FOG_API_PORT=8002
NEXT_PUBLIC_FOG_API_URL=http://127.0.0.1:8002

